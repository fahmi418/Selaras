# ===========================================================================
# Selaras Environment Configuration Template
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. AI Vision Extractor (Primary & Fallback)
# ---------------------------------------------------------------------------
# Primary: Google Gemini Vision API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# Secondary Fallback: NVIDIA NIM (OpenAI-compatible Vision endpoint)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------------------------------------------------------------------------
# 2. Database Connection
# ---------------------------------------------------------------------------
# Local SQLite (Default):
DATABASE_URL=sqlite+aiosqlite:///./selaras.db

# Railway / Cloud PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway

# ---------------------------------------------------------------------------
# 3. Security & App URLs
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
SECRET_KEY=selaras-secret-key-32chars-minimum-demo

# API Authentication Keys
ADMIN_API_KEY=admin-dev-key-12345
INTERNAL_API_KEY=internal-dev-key-12345

# Case access token TTL (hours)
CASE_TOKEN_TTL_HOURS=24

# ---------------------------------------------------------------------------
# 4. Telegram Bot Integration (Optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=selaras-webhook-secret-token

# ---------------------------------------------------------------------------
# 5. System Mode & Logs
# ---------------------------------------------------------------------------
SYNTH_SEED=42
DEMO_MODE=true
LOG_LEVEL=INFO
