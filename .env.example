# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# Database
DATABASE_URL=sqlite+aiosqlite:///./selaras.db

# App
APP_BASE_URL=https://your-domain.example.com
SECRET_KEY=change-me-to-a-random-256-bit-hex-string

# Auth keys (keep these secret)
ADMIN_API_KEY=
INTERNAL_API_KEY=

# Case access token TTL
CASE_TOKEN_TTL_HOURS=24

# Synthetic data
SYNTH_SEED=42

# Demo mode — disables real data ingestion, shows demo banner
DEMO_MODE=true

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
