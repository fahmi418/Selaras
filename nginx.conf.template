events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    client_max_body_size 50M;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    access_log /dev/stdout;
    error_log /dev/stderr info;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        LISTEN_DIRECTIVES

        server_name _;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;

        # Session check against FastAPI; 204 = logged in (or login disabled), 401 = not logged in.
        location = /_auth {
            internal;
            proxy_pass http://127.0.0.1:8001/auth/check;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
        }

        location @login {
            return 302 /login?next=/dashboard/;
        }

        # Streamlit Dashboard & WebSocket (login required)
        location /dashboard {
            auth_request /_auth;
            error_page 401 = @login;
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400;
        }

        # FastAPI Backend (Web UI, API, Webhook, Docs)
        location / {
            proxy_pass http://127.0.0.1:8001;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300;
        }
    }
}
